@page "/login"
@using AnimalZ.Services
@inject NavigationManager Navigation

<div class="min-h-screen bg-gradient-to-br from-green-50 to-blue-50 flex items-center justify-center p-4">
    <div class="w-full max-w-md">
        <!-- Logo -->
        <div class="text-center mb-8">
            <img src="/assets/Animalz_logo.png" alt="AnimalZ Logo" class="h-24 w-auto mx-auto mb-4" />
            <h1 class="text-3xl font-bold text-gray-800">AnimalZ</h1>
            <p class="text-gray-600 mt-2">Adopt Your Animal!</p>
        </div>

        <div class="bg-white rounded-xl shadow-lg p-8 fade-in">
            @if (!isSignUp)
            {
                <h2 class="text-2xl font-semibold mb-6 text-gray-800">Sign In</h2>
                <form @onsubmit="SignIn">
                    <div class="mb-4">
                        <label class="block text-gray-700 mb-2">Email</label>
                        <input @bind="email" type="email" required 
                               class="w-full px-3 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" />
                    </div>
                    <div class="mb-4">
                        <label class="block text-gray-700 mb-2">Password</label>
                        <input @bind="password" type="password" required 
                               class="w-full px-3 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" />
                    </div>
                    <button type="submit" class="w-full bg-blue-500 text-white py-2 rounded-lg hover:bg-blue-600 transition">Sign In</button>
                </form>
                <p class="mt-4 text-center">Don't have an account? 
                    <a href="#" @onclick="() => SwitchToSignUp()" class="text-blue-600 hover:underline font-medium">Create Account</a></p>
            }
            else
            {
                <h2 class="text-2xl font-semibold mb-6 text-gray-800">Create Account</h2>
                <form @onsubmit="SignUp">
                    <div class="mb-4">
                        <label class="block text-gray-700 mb-2">Email</label>
                        <input @bind="email" type="email" required 
                               class="w-full px-3 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" />
                    </div>
                    <div class="mb-4">
                        <label class="block text-gray-700 mb-2">Display Name</label>
                        <input @bind="displayName" type="text" required 
                               class="w-full px-3 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" />
                    </div>
                    <div class="mb-4">
                        <label class="block text-gray-700 mb-2">Password</label>
                        <input @bind="password" type="password" required 
                               class="w-full px-3 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" />
                    </div>
                    <button type="submit" class="w-full bg-green-500 text-white py-2 rounded-lg hover:bg-green-600 transition">Sign Up</button>
                </form>
                <p class="mt-4 text-center">Already have an account? 
                    <a href="#" @onclick="() => SwitchToSignIn()" class="text-blue-600 hover:underline font-medium">Sign In</a></p>
            }

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <p class="mt-4 text-red-500 text-center">@errorMessage</p>
            }
        </div>
    </div>
</div>

@code {
    [Inject] public SupabaseService? SupabaseSvc { get; set; }
    
    private bool isSignUp = false;
    private string email = "";
    private string password = "";
    private string displayName = "";
    private string errorMessage = "";

    private void SwitchToSignUp() => isSignUp = true;
    private void SwitchToSignIn() => isSignUp = false;

    private async Task SignIn()
    {
        try
        {
            if (SupabaseSvc != null)
            {
                await SupabaseSvc.SignInAsync(email, password);
            }
            Navigation.NavigateTo("/pet-store");
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task SignUp()
    {
        try
        {
            if (SupabaseSvc != null)
            {
                await SupabaseSvc.SignUpAsync(email, password, displayName);
            }
            Navigation.NavigateTo("/pet-store");
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }
