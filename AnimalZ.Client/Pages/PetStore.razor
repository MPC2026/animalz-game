@page "/pet-store"
@using AnimalZ.Models
@inject NavigationManager Navigation

<h1 class="text-3xl font-bold text-center mt-6">Zoo Animals - Adopt Your Pet!</h1>

<div class="max-w-6xl mx-auto p-4">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        @foreach (var animal in zooAnimals)
        {
            <div class="border rounded-lg p-4 shadow hover:shadow-lg transition">
                <img src="@animal.ImageUrl" alt="@animal.Name" class="w-full h-48 object-cover rounded mb-3" />
                <h2 class="text-xl font-semibold">@animal.Name</h2>
                <p class="text-gray-600 text-sm">@animal.Species</p>
                <p class="mt-2 text-sm">@animal.Description</p>
                <button @onclick="() => SelectAnimal(animal)" 
                        class="mt-3 w-full bg-blue-500 text-white py-2 rounded hover:bg-blue-600 transition">
                    Adopt @animal.Name
                </button>
            </div>
        }
    </div>

    @if (selectedAnimal != null)
    {
        <div class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
            <div class="bg-white rounded-lg p-6 max-w-md w-full">
                <h2 class="text-2xl font-semibold mb-4">Customize @selectedAnimal.Name</h2>
                
                <div class="mb-4">
                    <label class="block text-gray-700 mb-2">Nickname</label>
                    <input @bind="nickname" type="text" 
                           class="w-full px-3 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" />
                </div>

                <div class="mb-4">
                    <label class="block text-gray-700 mb-2">Color</label>
                    <select @bind="selectedColor" class="w-full px-3 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
                        @foreach (var color in availableColors)
                        {
                            <option value="@color.Value">@color.Key</option>
                        }
                    </select>
                </div>

                <div class="flex gap-3">
                    <button @onclick="AdoptAnimal" 
                            class="flex-1 bg-green-500 text-white py-2 rounded hover:bg-green-600 transition">
                        Adopt
                    </button>
                    <button @onclick="CancelCustomization" 
                            class="flex-1 bg-gray-300 text-gray-700 py-2 rounded hover:bg-gray-400 transition">
                        Cancel
                    </button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<Animal> zooAnimals = new();
    private Animal? selectedAnimal;
    private string nickname = "";
    private string selectedColor = "#FFD700";
    
    private Dictionary<string, string> availableColors = new()
    {
        ["Golden"] = "#FFD700",
        ["Blue"] = "#3B82F6",
        ["Green"] = "#10B981",
        ["Red"] = "#EF4444",
        ["Purple"] = "#8B5CF6"
    };

    protected override async Task OnInitializedAsync()
    {
        // TODO: Load animals from SupabaseService
        await LoadZooAnimals();
    }

    private async Task LoadZooAnimals()
    {
        // Sample data - will be replaced with actual API call
        zooAnimals = new List<Animal>
        {
            new Animal { Name = "Lion", Species = "Panthera leo", Description = "King of the jungle!", ImageUrl = "/images/lion.png" },
            new Animal { Name = "Elephant", Species = "Loxodonta africana", Description = "The largest land animal.", ImageUrl = "/images/elephant.png" },
            new Animal { Name = "Zebra", Species = "Equus quagga", Description = "Striped and proud!", ImageUrl = "/images/zebra.png" },
            new Animal { Name = "Giraffe", Species = "Giraffa camelopardalis", Description = "Tallest animal on Earth.", ImageUrl = "/images/giraffe.png" }
        };
    }

    private void SelectAnimal(Animal animal)
    {
        selectedAnimal = animal;
        nickname = "";
        selectedColor = "#FFD700";
    }

    private async Task AdoptAnimal()
    {
        if (selectedAnimal != null && !string.IsNullOrEmpty(nickname))
        {
            // TODO: Call SupabaseService to adopt the animal
            Navigation.NavigateTo("/park");
        }
    }

    private void CancelCustomization()
    {
        selectedAnimal = null;
    }
}